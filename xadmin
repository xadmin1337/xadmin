    }

    // Audio Context
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    
    function playSound(type) {
        if (!window.soundEnabled) return;
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        if (type === 'booking-soon') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(1046.5, audioCtx.currentTime + 0.1);
            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
            osc.start(); osc.stop(audioCtx.currentTime + 0.5);
        } else if (type === 'booking-late') {
            osc.type = 'square';
            osc.frequency.setValueAtTime(220, audioCtx.currentTime);
            osc.frequency.linearRampToValueAtTime(110, audioCtx.currentTime + 0.3);
            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gainNode.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
            osc.start(); osc.stop(audioCtx.currentTime + 0.3);
            setTimeout(() => {
                const osc2 = audioCtx.createOscillator();
                const gain2 = audioCtx.createGain();
                osc2.connect(gain2); gain2.connect(audioCtx.destination);
                osc2.type = 'square'; osc2.frequency.setValueAtTime(220, audioCtx.currentTime);
                gain2.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain2.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc2.start(); osc2.stop(audioCtx.currentTime + 0.3);
            }, 400);
        } else if (type === 'click') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(800, audioCtx.currentTime);
            gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
            osc.start(); osc.stop(audioCtx.currentTime + 0.1);
        }
    }

    window.toggleSound = function() {
        window.soundEnabled = !window.soundEnabled;
        document.getElementById('soundToggle').textContent = window.soundEnabled ? '🔊' : '🔇';
        if (window.soundEnabled && audioCtx.state === 'suspended') audioCtx.resume();
        playSound('click');
    };

    // --- REALTIME LISTENERS ---
    onValue(ref(db, 'pcs'), (snapshot) => {
        const data = snapshot.val();
        const statusEl = document.getElementById('connStatus');
        if (data) {
            for (let i = 1; i <= 43; i++) window.pcStatus[i] = data[i] !== undefined ? data[i] : 0;
            renderPCs();
            renderBookingGrid();
            statusEl.textContent = "ONLINE • SYNCED";
            statusEl.className = "connection-status status-online";
        } else {
            statusEl.textContent = "ONLINE • EMPTY DB";
            statusEl.className = "connection-status status-online";
        }
    });

    onValue(ref(db, 'gear'), (snapshot) => {
        const data = snapshot.val();
        if (data) {
            window.pcGear = data;
            updateGearVolumes();
            renderPCs();
        }
    });

    onValue(ref(db, 'bookings'), (snapshot) => {
        const data = snapshot.val();
        window.bookings = data ? Object.entries(data).map(([id, val]) => ({id, ...val})) : [];
        renderBookings();
        checkBookingAlerts();
        renderPCs();
        renderBookingGrid();
    });

    // --- UI FUNCTIONS ---
    window.switchTab = function(tabName, element) {
        playSound('click');
        element.classList.add('glitch');
        setTimeout(() => element.classList.remove('glitch'), 400);
        const scanline = document.getElementById('scanline');
        scanline.classList.remove('active'); void scanline.offsetWidth; scanline.classList.add('active');
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        element.classList.add('active');
        const content = document.getElementById(tabName);
        content.classList.add('active');
        content.classList.add('content-glitch');
        setTimeout(() => content.classList.remove('content-glitch'), 300);
    };

    window.renderPCs = function() {
        const zone = document.getElementById('pcZone').value;
        const grid = document.getElementById('pcGrid');
        grid.innerHTML = '';
        let startPc = 1, endPc = 43;
        if (zone === 'vip-open') { startPc = 1; endPc = 18; }
        else if (zone === 'bootcamp') { startPc = 19; endPc = 29; }
        else if (zone === 'vip-room') { startPc = 30; endPc = 38; }
        else if (zone === 'duo-trio') { startPc = 39; endPc = 43; }

        let free = 0, busy = 0;
        const now = Date.now();

        for (let i = startPc; i <= endPc; i++) {
            const status = window.pcStatus[i] || 0;
            const gear = window.pcGear[i] || [];
            
            let bookingClass = '';
            let bookingIcon = '';
            window.bookings.forEach(b => {
                if (b.pcs && b.pcs.includes(i)) {
                    const startTime = new Date(b.start).getTime();
                    const endTime = startTime + (b.duration * 3600000);
                    if (now >= startTime - 900000 && now < startTime) bookingClass = 'booking-soon';
                    else if (now >= startTime && now < endTime && status === 0) bookingClass = 'booking-late';
                    if (bookingClass) bookingIcon = '🔒';
                }
            });

            const pc = document.createElement('div');
            pc.className = `pc-item ${status === 0 ? 'free' : 'busy'} ${bookingClass}`;
            if (i <= 18) pc.classList.add('vip');
            else if (i <= 29) pc.classList.add('bootcamp');
            else if (i <= 38) pc.classList.add('vip-room');
            else pc.classList.add('duo-trio');
            
            let iconsHtml = gear.map(g => {
                if (g.type === 'g102') return '🖱️';
                if (g.type === 'viper') return '🐍';
                if (g.type === 'rival3') return '🛡️';
                return '';
            }).join(' ');

            pc.innerHTML = `
                <div class="pc-number">${i} ${bookingIcon}</div>
                <div class="pc-status">${status === 0 ? 'свободен' : 'занят'}</div>
                <div class="pc-icons">${iconsHtml}</div>
            `;
            
            pc.onclick = () => handlePcClick(i, status);
            grid.appendChild(pc);
            if (status === 0) free++; else busy++;
        }
        document.getElementById('freeCount').textContent = free;
        document.getElementById('busyCount').textContent = busy;
        document.getElementById('totalCount').textContent = endPc - startPc + 1;
    };

    // FIXED: Click logic with Action Modal for Busy PCs
    function handlePcClick(pcNum, status) {
        playSound('click');
        
        // If BUSY -> Show Action Modal (Gear OR Finish)
        if (status === 1) {
            window.currentActionPc = pcNum;
            document.getElementById('actionModalPcNum').textContent = pcNum;
            document.getElementById('pcActionModal').classList.add('active');
        } 
        // If FREE -> Toggle Status immediately
        else {
            const newStatus = status === 0 ? 1 : 0;
            set(ref(db, 'pcs/' + pcNum), newStatus);
            
            // If freeing up PC, check for gear return
            if (newStatus === 0 && window.pcGear[pcNum] && window.pcGear[pcNum].length > 0) {
                showReturnModal(pcNum);
            }
        }
    }

    // Action Modal Functions
    window.openGearManagement = function() {
        closeModal('pcActionModal');
        window.currentGearPc = window.currentActionPc;
        openGearModal(window.currentGearPc);
    };

    window.finishSession = function() {
        const pcNum = window.currentActionPc;
        closeModal('pcActionModal');
        
        // Free the PC
        set(ref(db, 'pcs/' + pcNum), 0);
        
        // Check if gear needs returning
        if (window.pcGear[pcNum] && window.pcGear[pcNum].length > 0) {
            showReturnModal(pcNum);
        }
        playSound('click');
    };

    // --- GEAR SYSTEM ---
    function openGearModal(pcNum) {
        document.getElementById('gearModalPcInfo').textContent = `ПК №${pcNum} (ЗАНЯТ)`;
        const container = document.getElementById('gearListContainer');
        container.innerHTML = '';

        const types = [
            { id: 'g102', name: 'Logitech G102', icon: '🖱️' },
            { id: 'viper', name: 'Razer Viper', icon: '🐍' },
            { id: 'rival3', name: 'SteelSeries Rival 3', icon: '️' }
        ];

        types.forEach(type => {
            const currentGear = window.pcGear[pcNum] || [];
            const existingItem = currentGear.find(g => g.type === type.id);
            
            const div = document.createElement('div');
            div.className = 'gear-option';
            
            let actionHtml = '';
            if (existingItem) {
                actionHtml = `<button class="danger" onclick="removeGear(${pcNum}, '${type.id}', '${existingItem.id}')">🔄 Забрать ${existingItem.id}</button>`;
            } else {
                actionHtml = `<button class="secondary" onclick="issueGear(${pcNum}, '${type.id}')">➕ Выдать</button>`;
            }

            div.innerHTML = `
                <div class="gear-header">
                    <div class="gear-icon">${type.icon}</div>
                    <div class="gear-info">
                        <div class="gear-name">${type.name}</div>
                        <div class="gear-id">${existingItem ? existingItem.id : 'Свободно на складе'}</div>
                    </div>
                </div>
                <div class="gear-actions">${actionHtml}</div>
            `;
            container.appendChild(div);
        });

        document.getElementById('gearModal').classList.add('active');
    }

    window.issueGear = function(pcNum, type) {
        const currentGear = window.pcGear[pcNum] || [];
        const existingIds = currentGear.filter(g => g.type === type).map(g => parseInt(g.id.split('-')[1]));
        let nextId = 1;
        while (existingIds.includes(nextId)) nextId++;
        
        const newGear = { type: type, id: `${type.toUpperCase()}-${String(nextId).padStart(2, '0')}` };
        
        if (!window.pcGear[pcNum]) window.pcGear[pcNum] = [];
        window.pcGear[pcNum].push(newGear);
        set(ref(db, 'gear'), window.pcGear);
        
        playSound('click');
        openGearModal(pcNum);
    };

    window.removeGear = function(pcNum, type, gearId) {
        if (!window.pcGear[pcNum]) return;
        window.pcGear[pcNum] = window.pcGear[pcNum].filter(g => !(g.type === type && g.id === gearId));
        set(ref(db, 'gear'), window.pcGear);
        playSound('click');
        openGearModal(pcNum);
    };

    function showReturnModal(pcNum) {
        const gear = window.pcGear[pcNum];
        if (!gear || gear.length === 0) return;
        
        let html = '<ul style="list-style:none; padding:0;">';
        gear.forEach(g => {
            let name = g.type === 'g102' ? 'Logitech G102' : g.type === 'viper' ? 'Razer Viper' : 'SteelSeries Rival 3';
            html += `<li style="padding:5px 0; border-bottom:1px solid rgba(255,255,255,0.1);"> ${name} (${g.id})</li>`;
        });
        html += '</ul>';
        
        document.getElementById('returnModalText').innerHTML = `ПК №${pcNum}: Не забудьте забрать:`;
        document.getElementById('returnGearList').innerHTML = html;
        document.getElementById('returnModal').dataset.pc = pcNum;
        document.getElementById('returnModal').classList.add('active');
        playSound('booking-late');
    }

    window.confirmReturn = function() {
        const pcNum = parseInt(document.getElementById('returnModal').dataset.pc);
        delete window.pcGear[pcNum];
        set(ref(db, 'gear'), window.pcGear);
        closeModal('returnModal');
        playSound('click');
    };

    function updateGearVolumes() {
        const counts = { g102: 0, viper: 0, rival3: 0 };
        Object.values(window.pcGear).forEach(gearList => {
            gearList.forEach(g => { if (counts[g.type] !== undefined) counts[g.type]++; });
        });
        
        ['g102', 'viper', 'rival3'].forEach(type => {
            const pct = (counts[type] / 5) * 100;
            document.getElementById(`vol-${type}`).style.width = `${pct}%`;
            document.getElementById(`vol-${type}-text`).textContent = `${counts[type]}/5`;
        });
    }

    // --- BOOKING SYSTEM ---
    function initDateButtons() {
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        document.getElementById('todayNum').textContent = today.getDate();
        document.getElementById('tomorrowNum').textContent = tomorrow.getDate();
    }
    initDateButtons();

    window.setBookingDate = function(offset) {
        window.bookingDateOffset = offset;
        document.getElementById('dateToday').classList.toggle('active', offset === 0);
        document.getElementById('dateTomorrow').classList.toggle('active', offset === 1);
        playSound('click');
    };

    function renderBookingGrid() {
        const grid = document.getElementById('bookingPcGrid');
        grid.innerHTML = '';
        
        for (let i = 1; i <= 43; i++) {
            const pc = document.createElement('div');
            const isSelected = window.selectedBookingPcs.has(i);
            const status = window.pcStatus[i] || 0;
            
            pc.className = `pc-item ${status === 0 ? 'free' : 'busy'} ${isSelected ? 'selected-for-booking' : ''}`;
            if (i <= 18) pc.classList.add('vip');
            else if (i <= 29) pc.classList.add('bootcamp');
            else if (i <= 38) pc.classList.add('vip-room');
            else pc.classList.add('duo-trio');
            
            pc.innerHTML = `<div class="pc-number">${i}</div>`;
            pc.onclick = () => toggleBookingPc(i);
            grid.appendChild(pc);
        }
    }

    function toggleBookingPc(pcNum) {
        playSound('click');
        if (window.selectedBookingPcs.has(pcNum)) {
            window.selectedBookingPcs.delete(pcNum);
        } else {
            window.selectedBookingPcs.add(pcNum);
        }
        renderBookingGrid();
    }

    window.createBooking = function() {
        if (window.selectedBookingPcs.size === 0) { alert('Выберите хотя бы один ПК!'); return; }
        
        const timeStr = document.getElementById('bookingTime').value;
        const duration = parseFloat(document.getElementById('bookingDuration').value);
        const client = document.getElementById('bookingClient').value;
        
        if (!timeStr || !client) { alert('Заполните время и имя клиента!'); return; }
        
        const targetDate = new Date();
        targetDate.setDate(targetDate.getDate() + window.bookingDateOffset);
        const [hours, minutes] = timeStr.split(':');
        targetDate.setHours(parseInt(hours), parseInt(minutes), 0, 0);
        
        const pcsArray = Array.from(window.selectedBookingPcs).sort((a,b) => a-b);
        
        const id = Date.now().toString();
        set(ref(db, `bookings/${id}`), { 
            pcs: pcsArray, 
            start: targetDate.toISOString(), 
            duration, 
            client, 
            created: Date.now() 
        });
        
        window.selectedBookingPcs.clear();
        document.getElementById('bookingClient').value = '';
        renderBookingGrid();
        playSound('click');
        alert(`Бронь создана на ПК: ${pcsArray.join(', ')}!`);
    };

    function renderBookings() {
        const container = document.getElementById('activeBookings');
        if (window.bookings.length === 0) {
            container.innerHTML = '<p style="text-align:center; color:#7c4dff;">Нет активных броней</p>';
            return;
        }
        
        let html = '<div style="display:flex; flex-direction:column; gap:10px;">';
        window.bookings.sort((a,b) => new Date(a.start) - new Date(b.start)).forEach(b => {
            const startDate = new Date(b.start);
            const isPast = Date.now() > startDate.getTime() + (b.duration * 3600000);
            const color = isPast ? '#f44336' : '#ffeb3b';
            const pcsDisplay = b.pcs ? b.pcs.join(', ') : b.pc;
            
            html += `
            <div style="background:rgba(0,0,0,0.3); padding:15px; border-radius:8px; border-left:4px solid ${color}; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-weight:bold; color:#fff;">ПК №${pcsDisplay} • ${b.client}</div>
                    <div style="font-size:12px; color:#b388ff;">${startDate.toLocaleString()} (${b.duration}ч)</div>
                </div>
                <button class="secondary danger" style="width:auto; padding:8px 15px; margin:0;" onclick="cancelBooking('${b.id}')">Отмена</button>
            </div>`;
        });
        html += '</div>';
        container.innerHTML = html;
    }

    window.cancelBooking = function(id) {
        playSound('click');
        remove(ref(db, `bookings/${id}`));
    };

    function checkBookingAlerts() {
        const now = Date.now();
        window.bookings.forEach(b => {
            if (!b.start) return;
            const startTime = new Date(b.start).getTime();
            const key = `alerted-${b.id}`;
            
            if (now >= startTime - 900000 && now < startTime && !localStorage.getItem(`${key}-soon`)) {
                playSound('booking-soon');
                localStorage.setItem(`${key}-soon`, 'true');
            }
            
            const anyPcActive = b.pcs ? b.pcs.some(pc => window.pcStatus[pc] === 1) : window.pcStatus[b.pc] === 1;
            if (now >= startTime + 900000 && !anyPcActive && !localStorage.getItem(`${key}-late`)) {
                playSound('booking-late');
                localStorage.setItem(`${key}-late`, 'true');
            }
        });
    }

    // --- CALCULATOR LOGIC ---
    const packages = [
        { name: "1ч День", h: 1, pWd: [175, 200, 250], pWe: [200, 225, 275], buyS: 0, buyE: 24, actS: 8, actE: 18 },
        { name: "3ч День", h: 3, pWd: [445, 510, 640], pWe: [510, 575, 700], buyS: 8, buyE: 15, actS: 8, actE: 18 },
        { name: "4ч День", h: 4, pWd: [560, 640, 800], pWe: [640, 720, 880], buyS: 8, buyE: 14, actS: 8, actE: 18 },
        { name: "5ч День", h: 5, pWd: [655, 750, 940], pWe: [750, 845, 1030], buyS: 8, buyE: 13, actS: 8, actE: 18 },
        { name: "1ч Вечер", h: 1, pWd: [200, 225, 275], pWe: [225, 250, 300], buyS: 0, buyE: 24, actS: 17, actE: 9.5 },
        { name: "3ч Вечер", h: 3, pWd: [540, 610, 745], pWe: [610, 675, 810], buyS: 17, buyE: 6.5, actS: 17, actE: 9.5 },
        { name: "4ч Вечер", h: 4, pWd: [680, 765, 935], pWe: [765, 850, 1020], buyS: 17, buyE: 5.5, actS: 17, actE: 9.5 },
        { name: "5ч Вечер", h: 5, pWd: [800, 900, 1100], pWe: [900, 1000, 1200], buyS: 17, buyE: 4.5, actS: 17, actE: 9.5 },
        { name: "10ч Ночь", h: 10, pWd: [1000, 1125, 1375], pWe: [1125, 1250, 1500], buyS: 20.5, buyE: 3, actS: 0, actE: 13 }
    ];
    const DEPOSIT_AMOUNT = 100;

    function updateDisplay() {
        const now = new Date();
        document.getElementById('displayTime').textContent = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
        const days = ['Воскресенье', 'Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота'];
        document.getElementById('displayDay').textContent = `${days[now.getDay()]} ${now.getDay()===0||now.getDay()===6?'(Выходной)':'(Будний)'}`;
    }
    setInterval(updateDisplay, 1000); updateDisplay();

    window.calculate = function() {
        const zoneIdx = parseInt(document.getElementById('zone').value);
        const hoursNeeded = parseFloat(document.getElementById('hoursInput').value);
        const now = new Date();
        const isWeekend = now.getDay() === 0 || now.getDay() === 6;
        const startTime = now.getHours() + (now.getMinutes() / 60);
        if (!hoursNeeded || hoursNeeded <= 0) { alert("Введите корректное количество часов!"); return; }
        const bestOption = findBestOption(startTime, hoursNeeded, zoneIdx, isWeekend);
        const resultsDiv = document.getElementById('results');
        if (bestOption) {
            resultsDiv.innerHTML = `<div class="result-card"><div class="result-header"><div class="result-title">${bestOption.title}<span class="badge-best">ЛУЧШИЙ</span></div><div class="result-price">${bestOption.price} ₽</div></div><div class="breakdown">${bestOption.desc}</div></div>`;
        } else { resultsDiv.innerHTML = `<div class="no-result">Нет доступных вариантов</div>`; }
    };

    function findBestOption(startTime, hoursNeeded, zoneIdx, isWeekend) {
        let bestOption = null, minPrice = Infinity;
        for (let pkg of packages) {
            if (Math.abs(pkg.h - hoursNeeded) < 0.01 && canBuyAtTime(pkg, startTime)) {
                const price = isWeekend ? pkg.pWe[zoneIdx] : pkg.pWd[zoneIdx];
                if (price < minPrice) { minPrice = price; bestOption = { title: `Пакет "${pkg.name}"`, price, desc: `Прямая продажа на ${hoursNeeded} часов` }; }
            }
        }
        const combinations = generateCombinations(startTime, hoursNeeded, zoneIdx, isWeekend);
        for (let combo of combinations) { if (combo.price < minPrice) { minPrice = combo.price; bestOption = combo; } }
        const hourlyPrice = calcHourly(startTime, hoursNeeded, zoneIdx, isWeekend);
        if (hourlyPrice < minPrice) { bestOption = { title: "Почасовая оплата", price: hourlyPrice, desc: `${hoursNeeded} часов по тарифу: ${hourlyPrice} ₽` }; }
        return bestOption;
    }

    function generateCombinations(startTime, hoursNeeded, zoneIdx, isWeekend) {
        let combinations = [];
        for (let firstPkg of packages) {
            if (firstPkg.h >= hoursNeeded || !canBuyAtTime(firstPkg, startTime)) continue;
            const firstPrice = isWeekend ? firstPkg.pWe[zoneIdx] : firstPkg.pWd[zoneIdx];
            const remainingHours = hoursNeeded - firstPkg.h;
            const afterFirstTime = startTime + firstPkg.h;
            const remainingOptions = findRemainingOptions(afterFirstTime, remainingHours, zoneIdx, isWeekend);
            for (let remaining of remainingOptions) {
                combinations.push({ title: `Пакет "${firstPkg.name}" + ${remaining.title}`, price: firstPrice + remaining.price, desc: `1. Пакет "<span class="highlight">${firstPkg.name}</span>": ${firstPrice} ₽<br>2. ${remaining.desc}<br><b>Итого: ${hoursNeeded} часов</b>` });
            }
        }
        return combinations;
    }

    function findRemainingOptions(startTime, hoursNeeded, zoneIdx, isWeekend) {
        let options = [];
        if (hoursNeeded <= 0) return [];
        if (hoursNeeded <= 0.5) return [{ title: 'Депозит', price: DEPOSIT_AMOUNT, desc: `Депозит ${DEPOSIT_AMOUNT} ₽ (30 мин)` }];
        for (let pkg of packages) {
            if (pkg.h > hoursNeeded || !canBuyAtTime(pkg, startTime)) continue;
            const pkgPrice = isWeekend ? pkg.pWe[zoneIdx] : pkg.pWd[zoneIdx];
            const remaining = hoursNeeded - pkg.h;
            const afterPkgTime = startTime + pkg.h;
            if (remaining <= 0.01) { options.push({ title: `Пакет "${pkg.name}"`, price: pkgPrice, desc: `Пакет "<span class="highlight">${pkg.name}</span>": ${pkgPrice} ₽` }); }
            else { const subOptions = findRemainingOptions(afterPkgTime, remaining, zoneIdx, isWeekend); for (let sub of subOptions) { options.push({ title: `Пакет "${pkg.name}" + ${sub.title}`, price: pkgPrice + sub.price, desc: `Пакет "<span class="highlight">${pkg.name}</span>": ${pkgPrice} ₽<br>${sub.desc}` }); } }
        }
        const hourlyPrice = calcHourly(startTime, hoursNeeded, zoneIdx, isWeekend);
        options.push({ title: `${hoursNeeded}ч по тарифу`, price: hourlyPrice, desc: `${hoursNeeded} часов по тарифу: ${hourlyPrice} ₽` });
        if (hoursNeeded < 1) options.push({ title: 'Депозит', price: DEPOSIT_AMOUNT, desc: `Депозит ${DEPOSIT_AMOUNT} ₽ (30 мин)` });
        return options;
    }

    function canBuyAtTime(pkg, time) {
        let canBuy = false;
        if (pkg.buyS > pkg.buyE) canBuy = (time >= pkg.buyS || time <= pkg.buyE);
        else if (pkg.buyS === 0 && pkg.buyE === 24) canBuy = true;
        else canBuy = (time >= pkg.buyS && time <= pkg.buyE);
        if (!canBuy) return false;
        const endTime = time + pkg.h;
        if (pkg.actS < pkg.actE) return (time >= pkg.actS && endTime <= pkg.actE);
        else { if (time >= pkg.actS) return true; if (time < pkg.actE && endTime <= pkg.actE + 24) return true; return false; }
    }

    function calcHourly(startTime, hours, zoneIdx, isWeekend) {
        let total = 0, currentTime = startTime;
        for (let i = 0; i < Math.ceil(hours); i++) {
            let isDay = (currentTime >= 8 && currentTime < 17);
            let rate = isDay ? (isWeekend ? packages[0].pWe[zoneIdx] : packages[0].pWd[zoneIdx]) : (isWeekend ? packages[4].pWe[zoneIdx] : packages[4].pWd[zoneIdx]);
            total += rate; currentTime += 1; if (currentTime >= 24) currentTime -= 24;
        }
        return Math.round(total);
    }

    // Helpers
    window.closeModal = function(id) { document.getElementById(id).classList.remove('active'); };
    
    // Init
    renderPCs();
    renderBookingGrid();
    setInterval(checkBookingAlerts, 60000);
</script>

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>X-Arena Manager | Ultimate</title>
    <style>
        /* --- CORE STYLES --- */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0a0a0f; color: #e0e0e0; min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; background-image: radial-gradient(circle at 20% 50%, rgba(156, 39, 176, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(123, 31, 162, 0.1) 0%, transparent 50%); }
        .container { max-width: 1000px; width: 100%; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); padding: 40px; border-radius: 20px; box-shadow: 0 0 40px rgba(156, 39, 176, 0.3), 0 0 80px rgba(156, 39, 176, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.1); border: 1px solid rgba(156, 39, 176, 0.3); position: relative; overflow: hidden; }
        .container::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: linear-gradient(45deg, transparent, rgba(156, 39, 176, 0.03), transparent); animation: shimmer 3s infinite; }
        @keyframes shimmer { 0% { transform: translateX(-100%) translateY(-100%); } 100% { transform: translateX(100%) translateY(100%); } }
        
        h2 { text-align: center; color: #e040fb; font-size: 32px; margin-bottom: 10px; text-shadow: 0 0 20px rgba(224, 64, 251, 0.5); position: relative; z-index: 1; }
        .subtitle { text-align: center; color: #7c4dff; font-size: 14px; margin-bottom: 30px; position: relative; z-index: 1; }

        /* --- TABS & EFFECTS --- */
        .tabs { display: flex; gap: 10px; margin-bottom: 30px; position: relative; z-index: 1; }
        .tab { flex: 1; padding: 15px; background: rgba(156, 39, 176, 0.1); border: 2px solid rgba(156, 39, 176, 0.3); border-radius: 10px; color: #b388ff; font-size: 16px; font-weight: bold; cursor: pointer; transition: all 0.3s; text-transform: uppercase; letter-spacing: 1px; text-align: center; position: relative; overflow: hidden; }
        .tab.active { background: linear-gradient(135deg, #9c27b0 0%, #7b1fa2 100%); border-color: #e040fb; color: #fff; box-shadow: 0 0 20px rgba(156, 39, 176, 0.4); }
        .tab:hover:not(.active) { background: rgba(156, 39, 176, 0.2); border-color: rgba(156, 39, 176, 0.5); }
        .tab.glitch { animation: tabGlitch 0.4s ease-out; }
        @keyframes tabGlitch { 0% { transform: translate(0); filter: hue-rotate(0deg); } 10% { transform: translate(-3px, 2px); filter: hue-rotate(90deg); } 20% { transform: translate(3px, -2px); filter: hue-rotate(180deg); } 30% { transform: translate(-2px, -1px); filter: hue-rotate(270deg); } 40% { transform: translate(2px, 1px); filter: hue-rotate(360deg); } 50% { transform: translate(-1px, 2px); } 60% { transform: translate(1px, -1px); } 70% { transform: translate(-1px, 0); } 80% { transform: translate(1px, 0); } 100% { transform: translate(0); filter: hue-rotate(0deg); } }
        
        .tab-content { display: none; position: relative; z-index: 1; }
        .tab-content.active { display: block; }
        
        .scanline-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999; opacity: 0; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(156, 39, 176, 0.1) 2px, rgba(156, 39, 176, 0.1) 4px); }
        .scanline-overlay.active { animation: scanline 0.5s ease-out; }
        @keyframes scanline { 0% { opacity: 0; transform: translateY(-100%); } 50% { opacity: 1; } 100% { opacity: 0; transform: translateY(100%); } }
        
        .content-glitch { animation: contentGlitch 0.3s ease-out; }
        @keyframes contentGlitch { 0% { opacity: 0; transform: scale(0.98) skewX(2deg); filter: blur(2px); } 30% { opacity: 0.7; transform: scale(1.01) skewX(-1deg); filter: blur(0); } 60% { opacity: 0.9; transform: scale(1) skewX(0.5deg); } 100% { opacity: 1; transform: scale(1) skewX(0); filter: blur(0); } }

        /* --- UI ELEMENTS --- */
        .time-display { background: rgba(156, 39, 176, 0.1); padding: 20px; border-radius: 12px; margin-bottom: 25px; border: 1px solid rgba(156, 39, 176, 0.3); text-align: center; }
        .time-display .time { font-size: 48px; font-weight: bold; color: #e040fb; text-shadow: 0 0 15px rgba(224, 64, 251, 0.6); font-variant-numeric: tabular-nums; }
        .time-display .day { font-size: 16px; color: #b388ff; margin-top: 8px; }
        
        .control-group { margin-bottom: 20px; }
        label { display: block; color: #b388ff; font-size: 13px; margin-bottom: 8px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
        select, input { width: 100%; padding: 15px; background: rgba(10, 10, 15, 0.6); border: 2px solid rgba(156, 39, 176, 0.3); border-radius: 10px; color: #fff; font-size: 16px; transition: all 0.3s; }
        select:focus, input:focus { outline: none; border-color: #e040fb; box-shadow: 0 0 15px rgba(224, 64, 251, 0.3); }
        
        button { width: 100%; padding: 18px; background: linear-gradient(135deg, #9c27b0 0%, #7b1fa2 100%); color: #fff; border: none; border-radius: 10px; font-size: 18px; font-weight: bold; cursor: pointer; transition: all 0.3s; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 4px 15px rgba(156, 39, 176, 0.4); }
        button:hover { background: linear-gradient(135deg, #ab47bc 0%, #8e24aa 100%); box-shadow: 0 6px 25px rgba(156, 39, 176, 0.6); transform: translateY(-2px); }
        button:active { transform: translateY(0); }
        button.secondary { background: rgba(156, 39, 176, 0.2); border: 1px solid #9c27b0; box-shadow: none; font-size: 14px; padding: 10px; margin-top: 10px; }
        button.secondary:hover { background: rgba(156, 39, 176, 0.4); }
        button.danger { background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%); box-shadow: 0 4px 15px rgba(244, 67, 54, 0.4); }
        button.danger:hover { background: linear-gradient(135deg, #ef5350 0%, #e53935 100%); }
        button.outline { background: transparent; border: 2px solid rgba(156, 39, 176, 0.5); color: #b388ff; box-shadow: none; }
        button.outline.active-date { background: rgba(156, 39, 176, 0.3); border-color: #e040fb; color: #fff; box-shadow: 0 0 15px rgba(224, 64, 251, 0.3); }

        /* --- PC GRID & BOOKING --- */
        .zone-selector { margin-bottom: 25px; }
        .pc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 10px; margin-top: 20px; }
        .pc-item { background: rgba(10, 10, 15, 0.6); border: 2px solid rgba(156, 39, 176, 0.3); border-radius: 8px; padding: 15px 10px; text-align: center; cursor: pointer; transition: all 0.3s; position: relative; user-select: none; }
        .pc-item.free { border-color: #00e676; background: rgba(0, 230, 118, 0.1); }
        .pc-item.free:hover { background: rgba(0, 230, 118, 0.2); box-shadow: 0 0 15px rgba(0, 230, 118, 0.3); transform: translateY(-2px); }
        .pc-item.busy { border-color: #f44336; background: rgba(244, 67, 54, 0.1); opacity: 0.9; }
        .pc-item.vip { border-color: #ffeb3b; }
        .pc-item.bootcamp { border-color: #9c27b0; }
        .pc-item.vip-room { border-color: #00bcd4; }
        .pc-item.duo-trio { border-color: #ff9800; }
        
        /* Selection for Booking */
        .pc-item.selected-for-booking { border-color: #e040fb !important; background: rgba(224, 64, 251, 0.3) !important; box-shadow: 0 0 15px rgba(224, 64, 251, 0.5); transform: scale(1.05); z-index: 2; }
        
        /* Booking States */
        .pc-item.booking-soon { border-color: #ffeb3b; animation: pulse-yellow 2s infinite; }
        .pc-item.booking-late { border-color: #f44336; animation: pulse-red 1s infinite; background: rgba(244, 67, 54, 0.3); }
        @keyframes pulse-yellow { 0% { box-shadow: 0 0 0 0 rgba(255, 235, 59, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(255, 235, 59, 0); } 100% { box-shadow: 0 0 0 0 rgba(255, 235, 59, 0); } }
        @keyframes pulse-red { 0% { box-shadow: 0 0 0 0 rgba(244, 67, 54, 0.7); } 70% { box-shadow: 0 0 0 15px rgba(244, 67, 54, 0); } 100% { box-shadow: 0 0 0 0 rgba(244, 67, 54, 0); } }

        .pc-number { font-size: 20px; font-weight: bold; color: #fff; margin-bottom: 5px; }
        .pc-status { font-size: 11px; color: #b388ff; text-transform: uppercase; }
        .pc-item.free .pc-status { color: #00e676; }
        .pc-item.busy .pc-status { color: #f44336; }
        .pc-icons { display: flex; justify-content: center; gap: 5px; margin-top: 5px; font-size: 12px; }

        /* --- GEAR VOLUME CONTROLS --- */
        .gear-panel { background: rgba(10, 10, 15, 0.8); border: 1px solid rgba(156, 39, 176, 0.3); border-radius: 12px; padding: 20px; margin-top: 20px; }
        .volume-control { margin-bottom: 20px; }
        .volume-label { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; color: #e040fb; font-weight: bold; }
        .volume-track { height: 12px; background: rgba(255, 255, 255, 0.1); border-radius: 6px; overflow: hidden; position: relative; cursor: pointer; }
        .volume-fill { height: 100%; background: linear-gradient(90deg, #9c27b0, #e040fb); width: 0%; transition: width 0.3s ease; border-radius: 6px; box-shadow: 0 0 10px rgba(224, 64, 251, 0.5); }
        .volume-markers { display: flex; justify-content: space-between; margin-top: 5px; font-size: 10px; color: #7c4dff; }

        /* --- MODALS --- */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(5px); z-index: 10000; display: none; justify-content: center; align-items: center; }
        .modal-overlay.active { display: flex; animation: fadeIn 0.3s; }
        .modal { background: #1a1a2e; border: 2px solid #9c27b0; border-radius: 15px; padding: 30px; width: 90%; max-width: 500px; box-shadow: 0 0 50px rgba(156, 39, 176, 0.5); position: relative; max-height: 90vh; overflow-y: auto; }
        .modal h3 { color: #e040fb; margin-bottom: 20px; font-size: 24px; text-align: center; }
        .modal-close { position: absolute; top: 15px; right: 15px; background: none; border: none; color: #b388ff; font-size: 24px; cursor: pointer; width: auto; padding: 0; box-shadow: none; }
        .modal-close:hover { color: #fff; }
        
        .action-buttons { display: flex; flex-direction: column; gap: 15px; margin-top: 20px; }
        .action-btn { padding: 20px; font-size: 18px; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 10px; }
        .action-btn.gear { background: linear-gradient(135deg, #00bcd4 0%, #0097a7 100%); box-shadow: 0 4px 15px rgba(0, 188, 212, 0.4); }
        .action-btn.gear:hover { background: linear-gradient(135deg, #26c6da 0%, #00acc1 100%); }
        .action-btn.finish { background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%); box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4); }
        .action-btn.finish:hover { background: linear-gradient(135deg, #66bb6a 0%, #43a047 100%); }
        
        .gear-option { display: flex; align-items: center; gap: 15px; padding: 15px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(156, 39, 176, 0.3); border-radius: 8px; margin-bottom: 10px; cursor: pointer; transition: all 0.2s; flex-direction: column; align-items: flex-start; }
        .gear-option:hover { background: rgba(156, 39, 176, 0.2); border-color: #e040fb; }
        .gear-header { display: flex; align-items: center; gap: 10px; width: 100%; }
        .gear-icon { font-size: 24px; }
        .gear-info { flex: 1; }
        .gear-name { font-weight: bold; color: #fff; }
        .gear-id { font-size: 12px; color: #b388ff; }
        .gear-actions { margin-top: 10px; width: 100%; display: flex; gap: 10px; }
        .gear-actions button { font-size: 12px; padding: 8px; }

        /* --- STATS & LEGEND --- */
        .stats { display: flex; gap: 15px; margin-top: 20px; flex-wrap: wrap; }
        .stat-card { flex: 1; min-width: 150px; background: rgba(156, 39, 176, 0.1); border: 1px solid rgba(156, 39, 176, 0.3); border-radius: 10px; padding: 15px; text-align: center; }
        .stat-value { font-size: 32px; font-weight: bold; color: #e040fb; }
        .stat-label { font-size: 12px; color: #b388ff; margin-top: 5px; text-transform: uppercase; }
        .legend { display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap; justify-content: center; }
        .legend-item { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #b388ff; }
        .legend-color { width: 20px; height: 20px; border-radius: 4px; border: 2px solid; }
        .legend-color.free { background: rgba(0, 230, 118, 0.2); border-color: #00e676; }
        .legend-color.busy { background: rgba(244, 67, 54, 0.2); border-color: #f44336; }
        .legend-color.booking { background: rgba(255, 235, 59, 0.2); border-color: #ffeb3b; }
        .legend-color.selected { background: rgba(224, 64, 251, 0.2); border-color: #e040fb; }

        /* --- CALCULATOR RESULTS --- */
        .result-area { margin-top: 30px; }
        .result-card { background: linear-gradient(135deg, rgba(156, 39, 176, 0.2) 0%, rgba(123, 31, 162, 0.1) 100%); border: 2px solid #ffeb3b; border-radius: 15px; padding: 25px; box-shadow: 0 0 40px rgba(255, 235, 59, 0.4); animation: fadeIn 0.5s; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid rgba(255, 235, 59, 0.5); flex-wrap: wrap; gap: 10px; }
        .result-title { font-size: 22px; font-weight: bold; color: #ffeb3b; text-shadow: 0 0 15px rgba(255, 235, 59, 0.5); }
        .result-price { font-size: 42px; font-weight: bold; color: #ffeb3b; text-shadow: 0 0 20px rgba(255, 235, 59, 0.6); }
        .badge-best { background: #ffeb3b; color: #000; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; margin-left: 10px; display: inline-block; }
        .breakdown { background: rgba(10, 10, 15, 0.6); padding: 15px; border-radius: 8px; font-size: 15px; line-height: 2; color: #ccc; }
        .breakdown b { color: #fff; }
        .breakdown .highlight { color: #e040fb; font-weight: bold; }
        .no-result { text-align: center; color: #f44336; font-size: 18px; padding: 30px; background: rgba(244, 67, 54, 0.1); border-radius: 10px; border: 1px solid rgba(244, 67, 54, 0.3); }
        
        .connection-status { position: absolute; top: 10px; right: 10px; font-size: 10px; padding: 4px 8px; border-radius: 4px; background: rgba(0,0,0,0.5); z-index: 10; }
        .status-online { color: #00e676; border: 1px solid #00e676; }
        .status-offline { color: #f44336; border: 1px solid #f44336; }
        .sound-toggle { position: absolute; top: 10px; left: 10px; font-size: 20px; cursor: pointer; z-index: 10; background: rgba(0,0,0,0.5); padding: 5px 10px; border-radius: 4px; border: 1px solid #9c27b0; }

        /* Date Picker Custom */
        .date-selector { display: flex; gap: 10px; margin-bottom: 15px; }
        .date-btn { flex: 1; padding: 15px; text-align: center; border: 2px solid rgba(156, 39, 176, 0.3); border-radius: 10px; cursor: pointer; transition: all 0.3s; background: rgba(10, 10, 15, 0.6); }
        .date-btn.active { background: rgba(156, 39, 176, 0.3); border-color: #e040fb; box-shadow: 0 0 15px rgba(224, 64, 251, 0.3); }
        .date-btn .day-num { font-size: 24px; font-weight: bold; color: #fff; display: block; }
        .date-btn .day-name { font-size: 12px; color: #b388ff; text-transform: uppercase; }
    </style>
</head>
<body>

<!-- Visual Effects -->
<div class="scanline-overlay" id="scanline"></div>
<div class="sound-toggle" id="soundToggle" onclick="toggleSound()">🔇</div>

<div class="container">
    <div id="connStatus" class="connection-status status-offline">Connecting...</div>
    
    <h2>X-Arena</h2>
    <div class="subtitle">Ultimate Management System</div>

    <!-- Tabs -->
    <div class="tabs">
        <div class="tab active" onclick="switchTab('calculator', this)">Калькулятор</div>
        <div class="tab" onclick="switchTab('computers', this)">💻 Компьютеры</div>
        <div class="tab" onclick="switchTab('bookings', this)">📅 Бронь</div>
    </div>

    <!-- Calculator Tab -->
    <div id="calculator" class="tab-content active">
        <div class="time-display">
            <div class="time" id="displayTime">--:--</div>
            <div class="day" id="displayDay">--</div>
        </div>
        <div class="control-group">
            <label>Зона</label>
            <select id="zone">
                <option value="0">VIP</option>
                <option value="1">BOOTCAMP</option>
                <option value="2">Standard (2/3)</option>
            </select>
        </div>
        <div class="control-group">
            <label>Сколько часов хочет клиент?</label>
            <input type="number" id="hoursInput" min="1" max="24" step="0.5" value="5" placeholder="Например: 5">
        </div>
        <button onclick="calculate()">Рассчитать лучший вариант</button>
        <div id="results" class="result-area"></div>
    </div>

    <!-- Computers Tab -->
    <div id="computers" class="tab-content">
        <div class="zone-selector">
            <label>Выберите зону:</label>
            <select id="pcZone" onchange="renderPCs()">
                <option value="all">Все компьютеры</option>
                <option value="vip-open">VIP Open (1-18)</option>
                <option value="bootcamp">Bootcamp (19-29)</option>
                <option value="vip-room">VIP Room (30-38)</option>
                <option value="duo-trio">Duo/Trio (39-43)</option>
            </select>
        </div>

        <div class="stats">
            <div class="stat-card"><div class="stat-value" id="totalCount">43</div><div class="stat-label">Всего ПК</div></div>
            <div class="stat-card"><div class="stat-value" id="freeCount">43</div><div class="stat-label" style="color: #00e676">Свободно</div></div>
            <div class="stat-card"><div class="stat-value" id="busyCount">0</div><div class="stat-label" style="color: #f44336">Занято</div></div>
        </div>

        <div id="pcGrid" class="pc-grid"></div>

        <!-- Gear Volume Panel -->
        <div class="gear-panel">
            <label style="margin-bottom: 15px; display: block;"> Выдано оборудования (Объем)</label>
            
            <div class="volume-control">
                <div class="volume-label"><span>Logitech G102</span><span id="vol-g102-text">0/5</span></div>
                <div class="volume-track"><div class="volume-fill" id="vol-g102"></div></div>
                <div class="volume-markers"><span>0</span><span>2</span><span>4</span><span>5</span></div>
            </div>

            <div class="volume-control">
                <div class="volume-label"><span>Razer Viper</span><span id="vol-viper-text">0/5</span></div>
                <div class="volume-track"><div class="volume-fill" id="vol-viper" style="background: linear-gradient(90deg, #00e676, #69f0ae);"></div></div>
                <div class="volume-markers"><span>0</span><span>2</span><span>4</span><span>5</span></div>
            </div>

            <div class="volume-control">
                <div class="volume-label"><span>SteelSeries Rival 3</span><span id="vol-rival3-text">0/5</span></div>
                <div class="volume-track"><div class="volume-fill" id="vol-rival3" style="background: linear-gradient(90deg, #ff9800, #ffb74d);"></div></div>
                <div class="volume-markers"><span>0</span><span>2</span><span>4</span><span>5</span></div>
            </div>
        </div>

        <div class="legend">
            <div class="legend-item"><div class="legend-color free"></div><span>Свободен</span></div>
            <div class="legend-item"><div class="legend-color busy"></div><span>Занят</span></div>
            <div class="legend-item"><div class="legend-color booking"></div><span>Бронь</span></div>
            <div class="legend-item"><div class="legend-color selected"></div><span>Выбран для брони</span></div>
        </div>
    </div>

    <!-- Bookings Tab -->
    <div id="bookings" class="tab-content">
        <div class="control-group">
            <label>Выберите ПК для брони (можно несколько):</label>
            <div id="bookingPcGrid" class="pc-grid" style="margin-top: 10px; max-height: 300px; overflow-y: auto;"></div>
            <p style="font-size: 12px; color: #7c4dff; margin-top: 5px;">💡 Кликните на ПК, чтобы добавить/убрать из брони</p>
        </div>

        <div class="control-group">
            <label>Дата начала:</label>
            <div class="date-selector">
                <div class="date-btn active" id="dateToday" onclick="setBookingDate(0)">
                    <span class="day-num" id="todayNum">--</span>
                    <span class="day-name">Сегодня</span>
                </div>
                <div class="date-btn" id="dateTomorrow" onclick="setBookingDate(1)">
                    <span class="day-num" id="tomorrowNum">--</span>
                    <span class="day-name">Завтра</span>
                </div>
            </div>
        </div>

        <div class="control-group">
            <label>Время начала:</label>
            <input type="time" id="bookingTime" value="20:00">
        </div>

        <div class="control-group">
            <label>Длительность (часов):</label>
            <input type="number" id="bookingDuration" min="1" max="12" value="2">
        </div>
        <div class="control-group">
            <label>Имя клиента / Телефон:</label>
            <input type="text" id="bookingClient" placeholder="Иван +7999...">
        </div>
        <button onclick="createBooking()">Забронировать</button>
        
        <div id="activeBookings" style="margin-top: 30px;"></div>
    </div>
</div>

<!-- Modals -->
<div class="modal-overlay" id="pcActionModal">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('pcActionModal')">×</button>
        <h3>🖥️ ПК №<span id="actionModalPcNum">--</span></h3>
        <p style="text-align:center; color:#b388ff; margin-bottom:20px;">Что хотите сделать?</p>
        
        <div class="action-buttons">
            <button class="action-btn gear" onclick="openGearManagement()">🎧 Выдать оборудование</button>
            <button class="action-btn finish" onclick="finishSession()">✅ Завершить сеанс</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="gearModal">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('gearModal')">×</button>
        <h3>🎧 Управление оборудованием</h3>
